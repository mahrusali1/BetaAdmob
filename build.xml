<?xml version="1.0" encoding="UTF-8"?>
<project name="BetaAdmob" default="all">

    <!-- Property Direktori Utama -->
    <property name="src.dir" location="src" />
    <property name="lib.dir" location="lib" />
    <property name="build.dir" location="build" />
    <property name="classes.dir" location="${build.dir}/classes" />
    <property name="external.dir" location="${build.dir}/externalComponents" />
    <property name="external.classes.dir" location="${build.dir}/externalComponents-classes" />
    <property name="out.dir" location="out" />

    <!-- Classpath untuk Membaca Seluruh JAR di Folder lib/ dan Sub-foldernya -->
    <path id="classpath">
        <fileset dir="${lib.dir}">
            <include name="**/*.jar" />
        </fileset>
    </path>

    <!-- Cleaning Output -->
    <target name="clean">
        <delete dir="${build.dir}" />
        <delete dir="${out.dir}" />
    </target>

    <!-- Inisialisasi Folder -->
    <target name="init">
        <mkdir dir="${build.dir}" />
        <mkdir dir="${classes.dir}" />
        <mkdir dir="${external.dir}" />
        <mkdir dir="${external.classes.dir}" />
        <mkdir dir="${out.dir}" />
    </target>

    <!-- Kompilasi Sumber Daya Java (Javac) -->
    <target name="javac" depends="init">
        <javac srcdir="${src.dir}" 
               destdir="${classes.dir}" 
               includeantruntime="false"
               encoding="UTF-8"
               source="1.8"
               target="1.8">
            <classpath refid="classpath" />
        </javac>
    </target>

    <!-- Generasi Komponen Ekstensi (.aix) -->
    <target name="process" depends="javac">
        <!-- Menjalankan ExternalComponentGenerator dari App Inventor -->
        <java classname="com.google.appinventor.components.scripts.ExternalComponentGenerator" 
              fork="true" 
              failonerror="true">
            <classpath refid="classpath" />
            <arg value="${classes.dir}" />
            <arg value="${external.dir}" />
            <arg value="${external.classes.dir}" />
            <arg value="${lib.dir}" />
        </java>

        <!-- Menyalin Hasil AIX ke Folder out/ -->
        <copy todir="${out.dir}">
            <fileset dir="${external.dir}">
                <include name="**/*.aix" />
            </fileset>
        </copy>
    </target>

    <!-- Target Utama -->
    <target name="all" depends="clean, process">
        <echo message="Build Selesai! Berkas AIX tersimpan di folder out/" />
    </target>

</project>
